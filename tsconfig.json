{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "composite": true,
    "rootDir": ".",
    "outDir": "./dist",
    "paths": {
      "@qr/contracts/*": ["./packages/contracts/*"],
      "@qr/qr-core": ["./packages/qr-core/src/index.ts"],
      "@qr/qr-core/*": ["./packages/qr-core/src/*"],
      "@qr/artistic-qr": ["./packages/artistic-qr/src/index.ts"],
      "@qr/artistic-qr/*": ["./packages/artistic-qr/src/*"],
      "@qr/design-system": ["./packages/design-system/src/index.ts"],
      "@qr/telemetry": ["./packages/telemetry/src/index.ts"]
    }
  },
  "include": ["packages/**/*", "apps/**/*"],
  "exclude": ["node_modules", "dist"]
}
