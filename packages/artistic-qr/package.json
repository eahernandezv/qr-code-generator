{
  "name": "@qr/artistic-qr",
  "version": "0.1.0",
  "description": "Artistic QR generation, validation, repair, and export",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./api": {
      "types": "./dist/api/index.d.ts",
      "default": "./dist/api/index.js"
    },
    "./render-intent": {
      "types": "./dist/render-intent.d.ts",
      "default": "./dist/render-intent.js"
    },
    "./service": {
      "types": "./dist/http-service.d.ts",
      "default": "./dist/http-service.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "test": "vitest run && python3 -m unittest discover -s provider -p 'test_*.py'",
    "lint": "tsc --noEmit",
    "start:service": "node dist/http-service-main.js"
  },
  "dependencies": {
    "@qr/qr-core": "workspace:*",
    "jsqr": "1.4.0",
    "pngjs": "7.0.0"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/pngjs": "6.0.5",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typescript": "5.4.5",
    "vitest": "3.2.7"
  }
}
