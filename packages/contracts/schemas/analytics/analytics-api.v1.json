{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://qr.internal/schemas/analytics/analytics-api.v1.json",
  "title": "Analytics API v1",
  "description": "Owner-scoped analytics query contract. Owned by WS-09 Analytics.",
  "type": "object",
  "required": ["query_id", "tenant_id", "time_range"],
  "properties": {
    "query_id": { "type": "string", "format": "uuid" },
    "tenant_id": { "type": "string" },
    "time_range": {
      "type": "object",
      "required": ["from", "to"],
      "properties": {
        "from": { "type": "string", "format": "date-time" },
        "to": { "type": "string", "format": "date-time" }
      }
    },
    "dimensions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["campaign", "route_class", "device_class", "response_category", "referrer_category", "coarse_region"]
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["scans", "unique_scans", "redirects", "errors", "latency_p50", "latency_p95", "latency_p99"]
      }
    }
  }
}
