{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://qr.ernesto.dev/schemas/qr-core-api.v1.json",
  "title": "QR Core API v1",
  "description": "Contracts for QR matrix generation, functional masks, and deterministic rendering. Owned by WS-03 (qr-creator).",
  "version": "1.0.0",
  "definitions": {
    "QrPayload": {
      "type": "object",
      "required": ["mode", "content"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["url", "text", "email", "phone", "wifi"],
          "description": "Payload encoding mode"
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2953,
          "description": "Normalized payload content"
        },
        "errorCorrectionLevel": {
          "type": "string",
          "enum": ["L", "M", "Q", "H"],
          "default": "M",
          "description": "Error correction level: L=7%, M=15%, Q=25%, H=30%"
        },
        "maskPattern": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7,
          "description": "Optional explicit mask pattern (0-7). If omitted, optimal mask is selected."
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 40,
          "description": "Optional explicit QR version (1-40). If omitted, minimal version is computed."
        }
      }
    },
    "NormalizedPayload": {
      "type": "object",
      "required": ["canonical", "mode", "byteLength", "version", "errorCorrectionLevel", "maskPattern"],
      "properties": {
        "canonical": {
          "type": "string",
          "description": "Canonical string after normalization (trimmed, lowercased URL scheme, etc.)"
        },
        "mode": {
          "type": "string",
          "enum": ["url", "text", "email", "phone", "wifi"]
        },
        "byteLength": {
          "type": "integer",
          "minimum": 1,
          "description": "Byte length of canonical content"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 40
        },
        "errorCorrectionLevel": {
          "type": "string",
          "enum": ["L", "M", "Q", "H"]
        },
        "maskPattern": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        }
      }
    },
    "QrMatrix": {
      "type": "object",
      "required": ["size", "modules", "version", "errorCorrectionLevel", "maskPattern", "functionalRegions"],
      "properties": {
        "size": {
          "type": "integer",
          "minimum": 21,
          "description": "Matrix dimension (width = height)"
        },
        "modules": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": "integer", "enum": [0, 1] }
          },
          "description": "2D array where 1=dark, 0=light"
        },
        "version": { "type": "integer", "minimum": 1, "maximum": 40 },
        "errorCorrectionLevel": { "type": "string", "enum": ["L", "M", "Q", "H"] },
        "maskPattern": { "type": "integer", "minimum": 0, "maximum": 7 },
        "functionalRegions": {
          "type": "object",
          "required": ["finderPatterns", "separators", "timingPatterns", "darkModule", "formatInfo", "versionInfo"],
          "properties": {
            "finderPatterns": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["x", "y", "size"],
                "properties": {
                  "x": { "type": "integer" },
                  "y": { "type": "integer" },
                  "size": { "type": "integer", "default": 7 }
                }
              }
            },
            "separators": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["x", "y", "size"],
                "properties": {
                  "x": { "type": "integer" },
                  "y": { "type": "integer" },
                  "size": { "type": "integer", "default": 8 }
                }
              }
            },
            "timingPatterns": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["orientation", "start", "end"],
                "properties": {
                  "orientation": { "type": "string", "enum": ["horizontal", "vertical"] },
                  "start": { "type": "integer" },
                  "end": { "type": "integer" }
                }
              }
            },
            "darkModule": {
              "type": "object",
              "required": ["x", "y"],
              "properties": {
                "x": { "type": "integer" },
                "y": { "type": "integer" }
              }
            },
            "formatInfo": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["x", "y", "isECI"],
                "properties": {
                  "x": { "type": "integer" },
                  "y": { "type": "integer" },
                  "isECI": { "type": "boolean" }
                }
              }
            },
            "versionInfo": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["x", "y"],
                "properties": {
                  "x": { "type": "integer" },
                  "y": { "type": "integer" }
                }
              }
            }
          }
        }
      }
    },
    "RenderOptions": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "enum": ["svg", "png-dataurl", "canvas"],
          "default": "svg"
        },
        "moduleSize": {
          "type": "integer",
          "minimum": 1,
          "default": 4,
          "description": "Size of one module in pixels/output units"
        },
        "margin": {
          "type": "integer",
          "minimum": 0,
          "default": 4,
          "description": "Quiet zone margin in modules"
        },
        "colorDark": {
          "type": "string",
          "default": "#000000",
          "description": "Dark module color (hex, rgb, rgba)"
        },
        "colorLight": {
          "type": "string",
          "default": "#ffffff",
          "description": "Light module color (hex, rgb, rgba)"
        },
        "shape": {
          "type": "string",
          "enum": ["square", "circle", "rounded"],
          "default": "square",
          "description": "Module shape for deterministic rendering"
        },
        "eyeShape": {
          "type": "string",
          "enum": ["square", "circle", "rounded"],
          "default": "square",
          "description": "Finder pattern (eye) shape"
        }
      }
    },
    "RenderedArtifact": {
      "type": "object",
      "required": ["format", "data", "width", "height", "metadata"],
      "properties": {
        "format": { "type": "string", "enum": ["svg", "png-dataurl"] },
        "data": { "type": "string", "description": "SVG string or base64 data URL" },
        "width": { "type": "integer" },
        "height": { "type": "integer" },
        "metadata": {
          "type": "object",
          "required": ["version", "errorCorrectionLevel", "maskPattern", "moduleSize", "margin"],
          "properties": {
            "version": { "type": "integer" },
            "errorCorrectionLevel": { "type": "string" },
            "maskPattern": { "type": "integer" },
            "moduleSize": { "type": "integer" },
            "margin": { "type": "integer" }
          }
        }
      }
    },
    "ScanTestResult": {
      "type": "object",
      "required": ["pass", "decoder", "version", "scannedPayload", "latencyMs"],
      "properties": {
        "pass": { "type": "boolean" },
        "decoder": { "type": "string", "description": "Decoder implementation identifier" },
        "version": { "type": "string", "description": "Decoder version" },
        "scannedPayload": { "type": "string" },
        "latencyMs": { "type": "integer", "minimum": 0 },
        "details": { "type": "object" }
      }
    }
  },
  "methods": {
    "normalizePayload": {
      "description": "Validate and canonicalize a user payload into normalized form suitable for QR encoding.",
      "input": { "$ref": "#/definitions/QrPayload" },
      "output": { "$ref": "#/definitions/NormalizedPayload" },
      "errors": [
        { "code": "PAYLOAD_TOO_LONG", "message": "Payload exceeds maximum capacity for selected error correction level" },
        { "code": "UNSUPPORTED_SCHEME", "message": "URL scheme is not supported" },
        { "code": "MALFORMED_PAYLOAD", "message": "Payload does not conform to mode requirements" }
      ]
    },
    "generateMatrix": {
      "description": "Generate a QR code matrix from a normalized payload.",
      "input": { "$ref": "#/definitions/NormalizedPayload" },
      "output": { "$ref": "#/definitions/QrMatrix" },
      "errors": [
        { "code": "MATRIX_GENERATION_FAILED", "message": "Unable to generate QR matrix" },
        { "code": "VERSION_OVERFLOW", "message": "Payload requires QR version > 40" }
      ]
    },
    "renderDeterministic": {
      "description": "Render a QR matrix to a deterministic visual artifact (SVG/PNG).",
      "input": {
        "type": "object",
        "required": ["matrix", "options"],
        "properties": {
          "matrix": { "$ref": "#/definitions/QrMatrix" },
          "options": { "$ref": "#/definitions/RenderOptions" }
        }
      },
      "output": { "$ref": "#/definitions/RenderedArtifact" },
      "errors": [
        { "code": "RENDER_FAILED", "message": "Unable to render QR to requested format" },
        { "code": "UNSUPPORTED_FORMAT", "message": "Requested output format is not supported" }
      ]
    },
    "decodeMatrix": {
      "description": "Decode a QR matrix back to payload for validation/testing.",
      "input": { "$ref": "#/definitions/QrMatrix" },
      "output": {
        "type": "object",
        "required": ["payload", "success"],
        "properties": {
          "payload": { "type": "string" },
          "success": { "type": "boolean" }
        }
      },
      "errors": [
        { "code": "DECODE_FAILED", "message": "Matrix could not be decoded" }
      ]
    }
  }
}
