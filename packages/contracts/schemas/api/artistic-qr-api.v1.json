{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "artistic-qr-api.v1",
  "title": "Artistic QR API v1",
  "description": "Artistic generation, validation, repair, and export",
  "type": "object",
  "required": ["payload", "artDirection"],
  "properties": {
    "payload": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2953
    },
    "artDirection": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["deterministic_template", "provider_generative"]
        },
        "templateId": { "type": "string" },
        "prompt": {
          "type": "string",
          "maxLength": 2000,
          "description": "Optional generation prompt; MUST be filtered for safety"
        },
        "referenceImage": {
          "type": "object",
          "properties": {
            "dataUrl": { "type": "string", "format": "uri" },
            "mimeType": { "type": "string", "enum": ["image/png", "image/jpeg", "image/webp"] }
          }
        },
        "artisticStrength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.5
        },
        "palette": {
          "type": "object",
          "properties": {
            "primary": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
            "secondary": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
            "accent": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "properties": {
        "suiteVersion": { "type": "string", "default": "v1" },
        "decoderResults": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["decoder", "pass", "confidence"],
            "properties": {
              "decoder": { "type": "string" },
              "pass": { "type": "boolean" },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
              "perturbation": { "type": "string" }
            }
          }
        },
        "thresholdDecision": {
          "type": "string",
          "enum": ["pass", "fail", "repairable"]
        },
        "exportAllowed": { "type": "boolean" }
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "mode": { "type": "string" },
        "provider": { "type": "string" },
        "model": { "type": "string" },
        "version": { "type": "string" },
        "latencyMs": { "type": "integer" },
        "costCents": { "type": "integer" }
      }
    }
  }
}
