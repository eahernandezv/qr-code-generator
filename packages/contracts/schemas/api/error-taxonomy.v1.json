{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "error-taxonomy.v1",
  "title": "Error Taxonomy v1",
  "description": "Shared error envelope schema for all API surfaces",
  "type": "object",
  "required": ["code", "message", "request_id"],
  "properties": {
    "code": {
      "type": "string",
      "description": "Stable machine-readable error code"
    },
    "message": {
      "type": "string",
      "description": "Safe human-readable message; never includes secrets or stack traces"
    },
    "request_id": { "type": "string" },
    "retryable": { "type": "boolean" },
    "details": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "field": { "type": "string" },
          "issue": { "type": "string" }
        }
      }
    }
  }
}
