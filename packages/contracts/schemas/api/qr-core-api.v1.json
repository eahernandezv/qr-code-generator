{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "qr-core-api.v1",
  "title": "QR Core API v1",
  "description": "Deterministic QR matrix generation, rendering, and safe export",
  "type": "object",
  "required": ["payload", "format"],
  "properties": {
    "payload": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2953,
      "description": "Normalized URL or text payload"
    },
    "format": {
      "type": "string",
      "enum": ["svg", "png"]
    },
    "errorCorrectionLevel": {
      "type": "string",
      "enum": ["L", "M", "Q", "H"],
      "default": "M"
    },
    "margin": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10,
      "default": 4
    },
    "color": {
      "type": "object",
      "properties": {
        "dark": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$", "default": "#000000" },
        "light": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$", "default": "#ffffff" }
      }
    },
    "logo": {
      "type": "object",
      "properties": {
        "dataUrl": { "type": "string", "format": "uri" },
        "coverageRatio": { "type": "number", "minimum": 0, "maximum": 0.3 }
      }
    }
  }
}
