{
  "name": "@qr/qr-core",
  "version": "0.1.0",
  "description": "QR matrix generation, functional masks, deterministic rendering",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./api": {
      "types": "./dist/api/index.d.ts",
      "default": "./dist/api/index.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/pngjs": "6.0.5",
    "@types/qrcode": "1.5.6",
    "typescript": "5.4.5",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "jsqr": "1.4.0",
    "pngjs": "7.0.0",
    "qrcode": "1.5.4"
  }
}
